{
	"compilerOptions": {
		"esModuleInterop": true,
		"lib": ["ES2020", "DOM"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "ES2020"
	},
	"exclude": ["node_modules", ".vscode-test"]
}
