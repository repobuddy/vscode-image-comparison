{
	"compilerOptions": {
		"esModuleInterop": true,
		"lib": ["ES2020", "DOM"],
		"module": "commonjs",
		"outDir": "dist",
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "ES2020"
	},
	"exclude": ["node_modules", ".vscode-test"]
}
