{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"check": {
			"dependsOn": ["^check"],
			"outputs": []
		},
		"storybook": {
			"cache": false,
			"persistent": true
		},
		"build-storybook": {
			"dependsOn": ["^build-storybook"],
			"outputs": ["storybook-static/**"]
		},
		"watch": {
			"cache": false,
			"persistent": true
		}
	}
}
