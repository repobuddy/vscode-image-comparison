{
	"name": "vscode-image-comparison",
	"displayName": "Image Comparison",
	"version": "0.0.1",
	"description": "Compare two images with a draggable slider.",
	"categories": [
		"Other"
	],
	"publisher": "unional",
	"type": "module",
	"main": "./dist/extension.js",
	"scripts": {
		"build": "tsc -p ./tsconfig.build.json",
		"build-storybook": "storybook build",
		"storybook": "storybook dev -p 6006",
		"vscode:prepublish": "npm run compile",
		"watch": "tsc -watch -p ./"
	},
	"contributes": {
		"commands": [
			{
				"command": "imageComparison.compareImages",
				"title": "Image Comparison: Compare Two Images"
			}
		]
	},
	"dependencies": {
		"pathe": "^2.0.3"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.2.0",
		"@storybook/addon-docs": "^10.2.0",
		"@storybook/addon-vitest": "^10.2.0",
		"@storybook/react-vite": "^10.2.0",
		"@vitest/browser-playwright": "^4.0.18",
		"@vitest/coverage-v8": "^4.0.18",
		"playwright": "^1.58.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"storybook": "^10.2.0",
		"typescript": "^5.4.5",
		"vitest": "^4.0.18"
	},
	"engines": {
		"vscode": "^1.90.0"
	}
}
